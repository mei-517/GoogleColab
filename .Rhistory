## def min_max
min_max <- functionn(x1,x2){
## def min_max
min_max <- function(x1,x2){
min_val <- apply(x2,2,min)
max_val <- apply(x2,2,max)
result <- (x1 - min_val)/(max_val - min_val)
return(result)
}
min_max(Xd,yd)
min_max(Xd,Xd)
